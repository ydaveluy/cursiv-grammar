{
  "version": 6,
  "configurePresets": [
    {
      "name": "native",
      "displayName": "every port (host toolchain)",
      "binaryDir": "${sourceDir}/build",
      "generator": "Ninja",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "native", "configurePreset": "native" }
  ],
  "testPresets": [
    { "name": "native", "configurePreset": "native", "output": { "outputOnFailure": true } }
  ]
}
