# Run native language benchmarks on the inputs registered by their CLI tests.
# Usage: cmake -DBUILD_DIR=build -P bench/run.cmake
cmake_minimum_required(VERSION 3.30)

if(NOT BUILD_DIR)
  set(BUILD_DIR "${CMAKE_CURRENT_LIST_DIR}/../build")
endif()
get_filename_component(BUILD_DIR "${BUILD_DIR}" ABSOLUTE)
if(NOT EXISTS "${BUILD_DIR}/CTestTestfile.cmake")
  message(FATAL_ERROR "No configured tests in ${BUILD_DIR}; configure the build first")
endif()
if(NOT DEFINED ITERATIONS)
  set(ITERATIONS 5)
endif()
if(NOT ITERATIONS MATCHES "^[1-9][0-9]*$")
  message(FATAL_ERROR "ITERATIONS must be a positive integer")
endif()
if(NOT OUT_DIR)
  set(OUT_DIR "${BUILD_DIR}/bench")
endif()
get_filename_component(OUT_DIR "${OUT_DIR}" ABSOLUTE)
string(REPLACE "," ";" LANGUAGES "${LANGUAGES}")
set(CTEST_CONFIGURATION_TYPE "${CONFIG}")

# CTest files contain absolute executable paths and the test's real inputs,
# including fixtures outside example/. Read them without executing unit tests.
function(subdirs)
  foreach(_dir IN LISTS ARGN)
    include("${CMAKE_CURRENT_LIST_DIR}/${_dir}/CTestTestfile.cmake" OPTIONAL)
  endforeach()
endfunction()

function(set_tests_properties)
endfunction()

function(add_test _name _cli)
  if(NOT _name MATCHES "^(.*)_cli_test$")
    return()
  endif()
  set(_id "${CMAKE_MATCH_1}")
  set(_port "${_id}")
  if(_cli MATCHES "/languages/([^/]+)/src/")
    set(_port "${CMAKE_MATCH_1}")
  else()
    foreach(_input IN LISTS ARGN)
      if(_input MATCHES "/languages/([^/]+)/")
        set(_port "${CMAKE_MATCH_1}")
        break()
      endif()
    endforeach()
  endif()
  if(LANGUAGES AND NOT _port IN_LIST LANGUAGES AND NOT _id IN_LIST LANGUAGES)
    return()
  endif()
  string(REGEX REPLACE "_cli(\\.exe)?$" "_bench\\1" _bench "${_cli}")
  if(NOT EXISTS "${_bench}")
    message(STATUS "${_port}: benchmark not built, skipped")
    return()
  endif()

  file(MAKE_DIRECTORY "${OUT_DIR}")
  set(_report "${OUT_DIR}/${_port}.json")
  file(REMOVE "${_report}")
  message(STATUS "Benchmark ${_port}")
  execute_process(COMMAND "${_bench}" ${ARGN}
      --iterations "${ITERATIONS}" --json "${_report}"
      WORKING_DIRECTORY "${BUILD_DIR}"
      RESULT_VARIABLE _result)
  set_property(GLOBAL APPEND PROPERTY BENCH_RUNS "${_port}")
  if(NOT _result STREQUAL "0")
    message(WARNING "${_port}: benchmark failed (${_result})")
    set_property(GLOBAL APPEND PROPERTY BENCH_FAILURES "${_port}")
  endif()
endfunction()

include("${BUILD_DIR}/CTestTestfile.cmake")
get_property(_runs GLOBAL PROPERTY BENCH_RUNS)
get_property(_failures GLOBAL PROPERTY BENCH_FAILURES)
list(LENGTH _runs _count)
if(_count EQUAL 0)
  message(FATAL_ERROR "No compiled benchmark found; build the bench target first")
endif()
message(STATUS "${_count} benchmark(s) run; JSON reports in ${OUT_DIR}")
if(_failures)
  message(FATAL_ERROR "Failed benchmarks: ${_failures}")
endif()
