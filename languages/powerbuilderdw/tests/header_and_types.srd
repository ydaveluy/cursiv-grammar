$PBEXPORTHEADER$D_TEST_TYPES.SRD
$PBEXPORTCOMMENTS$CONSTRUCT COVERAGE SAMPLE
RELEASE 12.0;
DATAWINDOW(UNITS=0 PROCESSING=0 HTMLDW=NO)
TABLE(COLUMN=(TYPE=CHAR(30) UPDATEWHERECLAUSE=YES NAME=CUSTOMER_NAME DBNAME="CUSTOMER.NAME")
 COLUMN=(TYPE=DECIMAL(2) NAME=CUSTOMER_BALANCE DBNAME="CUSTOMER.BALANCE" FILTER=(A=1 B=(C=2 D=3)))
 RETRIEVE="SELECT * FROM CUSTOMER WHERE COL = ~"X~" "
 ARGUMENTS=(("ID", INTEGER),("NAME", STRING))
 SORT="CUSTOMER_NAME A "
 )
COLUMN(BAND=DETAIL ID=1 NAME=CUSTOMER_NAME VISIBLE="1" ELEMENTS=INTEGER[-5 TO 5, 10] TAGS=STRING[])
SIMPLETABLE(COLUMN=(TYPE=INTEGER(4) NAME=ID) RETRIEVE="SELECT ID FROM SIMPLETABLE ")
