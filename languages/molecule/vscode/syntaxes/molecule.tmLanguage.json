{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Molecule",
  "scopeName": "source.molecule",
  "patterns": [
    {
      "include": "#elements"
    },
    {
      "include": "#counts"
    },
    {
      "include": "#brackets"
    },
    {
      "include": "#separator"
    }
  ],
  "repository": {
    "elements": {
      "name": "entity.name.tag.molecule",
      "match": "[A-Z][a-z]?"
    },
    "counts": {
      "name": "constant.numeric.molecule",
      "match": "[0-9]+"
    },
    "brackets": {
      "name": "punctuation.definition.group.molecule",
      "match": "[()\\[\\]]"
    },
    "separator": {
      "name": "keyword.operator.molecule",
      "match": "·"
    }
  }
}
