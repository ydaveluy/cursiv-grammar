$EXTERNAL Prout, Add;
$EXTERN Symb;
$EXTRN Numb;

* A line comment before the entry point.
$ENTRY Go {
  e.1 = <Prout e.1>;
}

/* A block comment
   spanning several lines. */
Classify {
  s.1 t.2 e.3, s.1 : 42 = <Prout 'digit-prefixed'>;
  s.1, s.1 : "control" = <Prout "control char">;
  e.1, e.1 : { 1 = True; e.2 = False; }
}

Backslash {
  \n = <Prout 'newline symbol'>;
  \x41 = <Prout 'hex escape'>;
  \' = <Prout 'quote escape'>;
}

"Weird Name" {
  = True;
}
