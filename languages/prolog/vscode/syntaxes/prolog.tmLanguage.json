{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Prolog",
  "scopeName": "source.prolog",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#variables" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.percentage.prolog",
          "match": "%.*$"
        },
        {
          "name": "comment.block.prolog",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.prolog",
          "begin": "'",
          "end": "'",
          "patterns": [{ "name": "constant.character.escape.prolog", "match": "\\\\." }]
        },
        {
          "name": "string.quoted.double.prolog",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "name": "constant.character.escape.prolog", "match": "\\\\." }]
        },
        {
          "name": "string.quoted.other.prolog",
          "begin": "`",
          "end": "`",
          "patterns": [{ "name": "constant.character.escape.prolog", "match": "\\\\." }]
        }
      ]
    },
    "keywords": {
      "name": "keyword.control.prolog",
      "match": "\\b(dynamic|multifile|discontiguous|public|is|rem|mod)\\b"
    },
    "variables": {
      "name": "variable.other.prolog",
      "match": "\\b([A-Z_][A-Za-z0-9_]*)\\b"
    },
    "numbers": {
      "name": "constant.numeric.prolog",
      "match": "\\b(0x[0-9a-fA-F]+|0o[0-7]+|0b[01]+|0'.|[0-9]+(\\.[0-9]+([eE][+-][0-9]+)?)?)\\b"
    }
  }
}
