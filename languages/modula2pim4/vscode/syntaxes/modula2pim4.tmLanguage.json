{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Modula2pim4",
  "scopeName": "source.modula2pim4",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "comments": {
      "name": "comment.block.modula2pim4",
      "begin": "\\(\\*",
      "end": "\\*\\)",
      "patterns": [
        {
          "include": "#comments"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.modula2pim4",
          "match": "\"[^\"]*\""
        },
        {
          "name": "string.quoted.single.modula2pim4",
          "match": "'[^']*'"
        }
      ]
    },
    "keywords": {
      "name": "keyword.control.modula2pim4",
      "match": "\\b(AND|ARRAY|BEGIN|BY|CASE|CONST|DEFINITION|DIV|DO|ELSE|ELSIF|END|EXIT|EXPORT|FOR|FROM|IF|IMPLEMENTATION|IMPORT|IN|LOOP|MOD|MODULE|NOT|OF|OR|POINTER|PROCEDURE|QUALIFIED|RECORD|REPEAT|RETURN|SET|THEN|TO|TYPE|UNTIL|VAR|WHILE|WITH)\\b"
    },
    "numbers": {
      "name": "constant.numeric.modula2pim4",
      "match": "\\b[0-9][0-9A-F]*[HBC]?\\b|\\b[0-9]+\\.[0-9]*(E[+-]?[0-9]+)?\\b"
    }
  }
}
