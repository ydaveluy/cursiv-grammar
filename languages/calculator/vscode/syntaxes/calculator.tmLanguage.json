{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Calculator",
  "scopeName": "source.calculator",
  "fileTypes": ["calc"],
  "patterns": [
    {
      "name": "support.function.calculator",
      "match": "\\b(cos|sin|tan|acos|asin|atan|log|ln|sqrt)\\b(?=\\s*\\()"
    },
    {
      "name": "constant.language.calculator",
      "match": "\\b(pi|e|i)\\b"
    },
    {
      "name": "constant.numeric.calculator",
      "match": "[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+(\\.[0-9]+)?)?"
    },
    {
      "name": "keyword.operator.calculator",
      "match": "[+\\-*/^=<>]"
    },
    {
      "name": "punctuation.parenthesis.calculator",
      "match": "[()]"
    },
    {
      "name": "punctuation.separator.calculator",
      "match": ","
    },
    {
      "name": "variable.other.calculator",
      "match": "[a-zA-Z_][a-zA-Z0-9_]*"
    }
  ]
}
