{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Suokif",
  "scopeName": "source.suokif",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.semicolon.suokif",
      "match": ";.*$"
    },
    "strings": {
      "name": "string.quoted.double.suokif",
      "begin": "\"",
      "end": "\""
    },
    "keywords": {
      "name": "keyword.control.suokif",
      "match": "\\b(not|and|or|forall|exists)\\b"
    },
    "variables": {
      "name": "variable.other.suokif",
      "match": "[?@][a-zA-Z][a-zA-Z0-9_-]*"
    },
    "numbers": {
      "name": "constant.numeric.suokif",
      "match": "-?\\b[0-9]+(\\.[0-9]+)?(e-?[0-9]+)?\\b"
    }
  }
}
