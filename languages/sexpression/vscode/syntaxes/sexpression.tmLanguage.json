{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Sexpression",
  "scopeName": "source.sexpression",
  "patterns": [
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#parens"
    }
  ],
  "repository": {
    "strings": {
      "name": "string.quoted.double.sexpression",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.sexpression",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.sexpression",
      "match": "[+-]?[0-9]+(\\.[0-9]+)?"
    },
    "parens": {
      "name": "punctuation.section.parens.sexpression",
      "match": "[()]"
    }
  }
}
