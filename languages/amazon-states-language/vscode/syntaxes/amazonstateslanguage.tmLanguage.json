{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AmazonStatesLanguage",
  "scopeName": "source.amazonstateslanguage",
  "patterns": [
    { "include": "#fieldNames" },
    { "include": "#paths" },
    { "include": "#strings" },
    { "include": "#constants" },
    { "include": "#numbers" }
  ],
  "repository": {
    "fieldNames": {
      "name": "support.type.property-name.amazonstateslanguage",
      "match": "\"(Comment|States|StartAt|Version|Type|Task|Choice|Fail|Succeed|Pass|Wait|Parallel|Map|Choices|Variable|Default|Branches|And|Not|Or|Resource|InputPath|OutputPath|ItemsPath|ResultPath|Result|Parameters|ResultSelector|Next|End|Cause|CausePath|Error|ErrorPath|Retry|ErrorEquals|IntervalSeconds|MaxAttempts|BackoffRate|MaxDelaySeconds|JitterStrategy|FULL|NONE|Catch|Seconds|SecondsPath|Timestamp|TimestampPath|TimeoutSeconds|TimeoutSecondsPath|HeartbeatSeconds|HeartbeatSecondsPath|ProcessorConfig|Mode|INLINE|DISTRIBUTED|ExecutionType|STANDARD|ItemProcessor|Iterator|ItemSelector|MaxConcurrency|ItemReader|ReaderConfig|InputType|CSVHeaderLocation|CSVHeaders|MaxItems|MaxItemsPath|BooleanEquals|BooleanEqualsPath|IsBoolean|IsNull|IsNumeric|IsPresent|IsString|IsTimestamp|NumericEquals|NumericEqualsPath|NumericGreaterThan(Path|Equals|EqualsPath)?|NumericLessThan(Path|Equals|EqualsPath)?|StringEquals(Path)?|StringGreaterThan(Path|Equals|EqualsPath)?|StringLessThan(Path|Equals|EqualsPath)?|StringMatches|TimestampEquals(Path)?|TimestampGreaterThan(Path|Equals|EqualsPath)?|TimestampLessThan(Path|Equals|EqualsPath)?|States\\.[A-Za-z]+)\"(?=\\s*:)",
      "captures": {
        "0": { "name": "support.type.property-name.amazonstateslanguage" }
      }
    },
    "paths": {
      "name": "variable.other.readwrite.amazonstateslanguage",
      "match": "\"\\${1,2}[^\"\\\\]*\""
    },
    "strings": {
      "name": "string.quoted.double.amazonstateslanguage",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.amazonstateslanguage",
          "match": "\\\\(u[0-9a-fA-F]{4}|.)"
        }
      ]
    },
    "constants": {
      "name": "constant.language.amazonstateslanguage",
      "match": "\\b(true|false|null)\\b"
    },
    "numbers": {
      "name": "constant.numeric.amazonstateslanguage",
      "match": "-?\\b(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?\\b"
    }
  }
}
