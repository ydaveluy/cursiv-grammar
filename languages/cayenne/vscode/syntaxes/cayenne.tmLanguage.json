{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Cayenne",
  "scopeName": "source.cayenne",
  "patterns": [
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "keywords": {
      "name": "keyword.control.cayenne",
      "match": "\\b(data|case|of|sig|struct|private|public|abstract|concrete)\\b"
    },
    "operators": {
      "name": "keyword.operator.cayenne",
      "match": "->|::|[@.|\\\\#=]"
    },
    "identifiers": {
      "name": "variable.other.cayenne",
      "match": "\\b[a-zA-Z][a-zA-Z0-9]*\\b"
    }
  }
}
