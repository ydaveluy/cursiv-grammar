{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Fdo91",
  "scopeName": "source.fdo91",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#marker"
    }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.number-sign.fdo91",
      "match": "#.*$"
    },
    "strings": {
      "name": "string.quoted.double.fdo91",
      "match": "\"[^\"\\r\\n]*\""
    },
    "numbers": {
      "name": "constant.numeric.fdo91",
      "match": "\\b[0-9]+(-[0-9]+){1,2}\\b|\\b[0-9]+\\b"
    },
    "marker": {
      "name": "keyword.other.fdo91",
      "match": "atom\\$"
    }
  }
}
