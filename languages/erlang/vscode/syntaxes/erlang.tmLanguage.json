{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Erlang",
  "scopeName": "source.erlang",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#attributes" },
    { "include": "#keywords" },
    { "include": "#numbers" },
    { "include": "#variables" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.percentage.erlang",
      "match": "%.*$"
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.erlang",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "name": "constant.character.escape.erlang", "match": "\\\\." }]
        },
        {
          "name": "string.quoted.other.erlang",
          "begin": "'",
          "end": "'",
          "patterns": [{ "name": "constant.character.escape.erlang", "match": "\\\\." }]
        }
      ]
    },
    "attributes": {
      "name": "keyword.control.directive.erlang",
      "match": "-\\s*(module|export|import|record|type|opaque|spec|callback|behaviour|behavior|define|include|include_lib|compile|vsn|on_load|file)\\b"
    },
    "keywords": {
      "name": "keyword.control.erlang",
      "match": "\\b(after|andalso|and|band|begin|bnot|bor|bsl|bsr|bxor|case|catch|cond|div|end|fun|if|let|not|of|orelse|or|receive|rem|try|when|xor)\\b"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.erlang",
          "match": "-?\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.erlang",
          "match": "-?\\b[0-9]+(#[0-9a-zA-Z]+)?\\b"
        },
        {
          "name": "constant.character.erlang",
          "match": "\\$\\\\?."
        }
      ]
    },
    "variables": {
      "name": "variable.other.erlang",
      "match": "\\b([A-Z_][a-zA-Z0-9_@]*)\\b"
    }
  }
}
