{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Muparser",
  "scopeName": "source.muparser",
  "patterns": [
    {
      "include": "#functions"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "functions": {
      "name": "support.function.muparser",
      "match": "\\b(sin|cos|tan|asin|acos|atan|sinh|cosh|tanh|asinh|acosh|atanh|log2|log10|log|ln|exp|sqrt|sign|rint|abs|min|max|sum|avg)\\b"
    },
    "constants": {
      "name": "constant.language.muparser",
      "match": "\\b(true|false|_e|_pi)\\b"
    },
    "numbers": {
      "name": "constant.numeric.muparser",
      "match": "\\b([0-9]+\\.[0-9]*|\\.[0-9]+|[0-9]+)\\b"
    },
    "operators": {
      "name": "keyword.operator.muparser",
      "match": "(\\+=|-=|\\*=|/=|==|!=|<=|>=|&&|\\|\\||[=+\\-*/^<>?:])"
    },
    "identifiers": {
      "name": "variable.other.muparser",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
    }
  }
}
