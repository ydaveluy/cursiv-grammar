{
  "name": "turtle",
  "displayName": "Turtle",
  "description": "The turtle language, parsed by cursiv",
  "version": "0.1.0",
  "publisher": "example",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:turtle"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "turtle",
        "aliases": [
          "Turtle"
        ],
        "extensions": [
          ".ttl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "turtle",
        "scopeName": "source.turtle",
        "path": "./syntaxes/turtle.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Turtle",
      "properties": {
        "turtle.server.path": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the turtle_lsp executable. Empty means the packaged copy, then ../build/."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "bundle": "node esbuild.mjs --production",
    "typecheck": "tsc -p tsconfig.json",
    "vscode:prepublish": "npm run bundle",
    "package": "vsce package --no-dependencies --allow-missing-repository"
  },
  "files": [
    "package.json",
    "out",
    "bin",
    "language-configuration.json",
    "syntaxes"
  ],
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.86.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2",
    "@vscode/vsce": "^3.2.0"
  }
}
