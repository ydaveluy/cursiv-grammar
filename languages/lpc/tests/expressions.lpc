void assign_ops(int a) {
    a += 1;
    a -= 1;
    a *= 2;
    a /= 2;
    a %= 2;
    a &= 1;
    a |= 1;
    a ^= 1;
    a <<= 1;
    a >>= 1;
}

int sscanf_test(string line) {
    int n;
    string rest;
    int matched = sscanf(line, "%d %s", n, rest);
    return matched;
}
