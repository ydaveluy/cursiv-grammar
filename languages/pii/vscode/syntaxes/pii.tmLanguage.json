{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Pii",
  "scopeName": "source.pii",
  "patterns": [
    {
      "include": "#prefix"
    },
    {
      "include": "#check"
    },
    {
      "include": "#digits"
    }
  ],
  "repository": {
    "prefix": {
      "name": "keyword.control.pii",
      "match": "^[SB]"
    },
    "check": {
      "name": "constant.language.pii",
      "match": "X"
    },
    "digits": {
      "name": "constant.numeric.pii",
      "match": "[0-9]+"
    }
  }
}
