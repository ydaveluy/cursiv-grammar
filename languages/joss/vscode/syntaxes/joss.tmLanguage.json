{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Joss",
  "scopeName": "source.joss",
  "patterns": [
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "strings": {
      "name": "string.quoted.single.joss",
      "match": "'[^']*'"
    },
    "keywords": {
      "name": "keyword.control.joss",
      "match": "\\b(Go|Cancel|Delete|Done|Stop|Demand|To|Set|Do|Type|Form|Line|Page|step|part|form|all|steps|parts|forms|values|size|time|users|in|if|for|and|or)\\b"
    },
    "functions": {
      "name": "support.function.joss",
      "match": "\\b(sqrt|log|exp|sin|cos|ip|fp|dp|xp|sgn|max|min)(?=\\()"
    },
    "numbers": {
      "name": "constant.numeric.joss",
      "match": "[0-9]+(\\.[0-9]+)?"
    }
  }
}
