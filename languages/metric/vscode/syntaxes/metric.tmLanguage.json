{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Metric",
  "scopeName": "source.metric",
  "patterns": [
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#units"
    }
  ],
  "repository": {
    "numbers": {
      "name": "constant.numeric.metric",
      "match": "[0-9]+"
    },
    "operators": {
      "name": "keyword.operator.metric",
      "match": "[*/^]"
    },
    "units": {
      "name": "support.type.unit.metric",
      "match": "[A-Za-zµΩ˚]+"
    }
  }
}
