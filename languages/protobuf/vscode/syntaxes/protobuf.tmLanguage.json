{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Protobuf",
  "scopeName": "source.protobuf",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.protobuf",
          "match": "//.*$"
        },
        {
          "name": "comment.block.protobuf",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.protobuf",
      "begin": "\"",
      "end": "\"",
      "patterns": [{ "name": "constant.character.escape.protobuf", "match": "\\\\." }]
    },
    "keywords": {
      "name": "keyword.control.protobuf",
      "match": "\\b(syntax|import|weak|public|package|option|optional|repeated|oneof|map|reserved|to|max|enum|message|service|extend|rpc|stream|returns)\\b"
    },
    "types": {
      "name": "storage.type.protobuf",
      "match": "\\b(double|float|int32|int64|uint32|uint64|sint32|sint64|fixed32|fixed64|sfixed32|sfixed64|bool|string|bytes)\\b"
    },
    "numbers": {
      "name": "constant.numeric.protobuf",
      "match": "\\b(0[xX][0-9a-fA-F]+|[0-9]+(\\.[0-9]*)?([eE][+-]?[0-9]+)?)\\b"
    }
  }
}
