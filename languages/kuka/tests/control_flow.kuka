DEF control()
DECL INT i
DECL BOOL done

FOR i=1 TO 10
i = i + 1
ENDFOR

FOR i=1 TO 10 STEP 2
CONTINUE
ENDFOR

IF i == 10 THEN
done = TRUE
ELSE
done = FALSE
ENDIF

WHILE i > 0
i = i - 1
ENDWHILE

REPEAT
i = i + 1
UNTIL i >= 5

LOOP
EXIT
ENDLOOP

SWITCH i
CASE 1, 2
done = TRUE
CASE 3
done = FALSE
DEFAULT
HALT
ENDSWITCH

start:
GOTO start

BRAKE
RETURN i
END
