BEGINNING-OF-PROGRAM

DEFINE turn-around AS
BEGIN
  TURNLEFT
  TURNLEFT
END

DEFINE patrol-step AS
BEGIN
  IF FRONT-IS-BLOCKED THEN
    turn-around
  ELSE
    MOVE
END

BEGINNING-OF-EXECUTION

  ITERATE 4 TIMES
    patrol-step

  WHILE NEXT-TO-A-BEEPER DO
    PICKBEEPER

  IF ANY-BEEPERS-IN-BEEPER-BAG THEN
    PUTBEEPER
  ELSE
    TURNLEFT

  BEGIN
    IF FRONT-IS-CLEAR THEN
      IF LEFT-IS-CLEAR THEN
        TURNLEFT
      ELSE
        MOVE
  END

  IF FRONT-IS-BLOCKED THEN MOVE
  IF LEFT-IS-CLEAR THEN MOVE
  IF LEFT-IS-BLOCKED THEN MOVE
  IF RIGHT-IS-CLEAR THEN MOVE
  IF RIGHT-IS-BLOCKED THEN MOVE
  IF BACK-IS-CLEAR THEN MOVE
  IF BACK-IS-BLOCKED THEN MOVE
  IF NEXT-TO-A-BEEPER THEN MOVE
  IF NOT-NEXT-TO-A-BEEPER THEN MOVE
  IF ANY-BEEPERS-IN-BEEPER-BAG THEN MOVE
  IF NO-BEEPERS-IN-BEEPER-BAG THEN MOVE
  IF FACING-NORTH THEN MOVE
  IF NOT-FACING-NORTH THEN MOVE
  IF FACING-SOUTH THEN MOVE
  IF NOT-FACING-SOUTH THEN MOVE
  IF FACING-EAST THEN MOVE
  IF NOT-FACING-EAST THEN MOVE
  IF FACING-WEST THEN MOVE
  IF NOT-FACING-WEST THEN MOVE

  TURNOFF

END-OF-EXECUTION

END-OF-PROGRAM
