{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "scotty",
  "scopeName": "source.scotty",
  "fileTypes": [
    "scotty"
  ],
  "patterns": [
    {
      "name": "keyword.control.scotty",
      "match": "\\bfun\\b"
    },
    {
      "name": "keyword.operator.scotty",
      "match": "[+*/]|-(?!\\d)"
    },
    {
      "name": "constant.numeric.scotty",
      "match": "-?[0-9][0-9.]*"
    }
  ]
}
