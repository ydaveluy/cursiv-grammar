{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Bicep",
  "scopeName": "source.bicep",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.bicep",
          "match": "//.*$"
        },
        {
          "name": "comment.block.bicep",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.number-sign.bicep",
          "match": "#disable-next-line.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.bicep",
          "match": "\\b(targetScope|import|with|as|metadata|param|resource|module|output|existing|type|var|if|for|in)\\b"
        },
        {
          "name": "constant.language.bicep",
          "match": "\\b(true|false|null)\\b"
        },
        {
          "name": "storage.type.bicep",
          "match": "\\b(string|int|bool|array|object)\\b"
        },
        {
          "name": "entity.name.function.decorator.bicep",
          "match": "@[a-zA-Z_][a-zA-Z_0-9]*(\\.[a-zA-Z_][a-zA-Z_0-9]*)*"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.bicep",
          "begin": "'''",
          "end": "'''"
        },
        {
          "name": "string.quoted.single.bicep",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.bicep",
              "match": "\\\\(['\\\\nrt$]|u\\{[0-9a-fA-F]+\\})"
            },
            {
              "name": "meta.embedded.expression.bicep",
              "begin": "\\$\\{",
              "end": "\\}",
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.bicep",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    }
  }
}
