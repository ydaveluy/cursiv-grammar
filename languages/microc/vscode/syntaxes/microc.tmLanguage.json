{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Microc",
  "scopeName": "source.microc",
  "patterns": [
    {
      "include": "#keywords"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "keywords": {
      "name": "keyword.control.microc",
      "match": "\\b(if|else|while)\\b"
    },
    "numbers": {
      "name": "constant.numeric.microc",
      "match": "\\b[0-9]+\\b"
    }
  }
}
