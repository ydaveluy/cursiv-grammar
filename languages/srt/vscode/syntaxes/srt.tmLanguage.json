{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Srt",
  "scopeName": "source.srt",
  "patterns": [
    {
      "include": "#timestamp"
    },
    {
      "include": "#index"
    }
  ],
  "repository": {
    "timestamp": {
      "match": "([0-9]+:[0-5][0-9]:[0-5][0-9],[0-9]{3})( --> )([0-9]+:[0-5][0-9]:[0-5][0-9],[0-9]{3})",
      "captures": {
        "1": {
          "name": "constant.numeric.time.srt"
        },
        "2": {
          "name": "keyword.operator.arrow.srt"
        },
        "3": {
          "name": "constant.numeric.time.srt"
        }
      }
    },
    "index": {
      "name": "constant.numeric.index.srt",
      "match": "^[0-9]+$"
    }
  }
}
