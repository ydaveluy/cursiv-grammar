[%
    if 1 eq 1 then 2 else 3 fi,
    if 1 eq 1 then 2 elseif 2 eq 2 then 4 endif,
    case 1 of 1 : 10 ; 2 : 20 ; default : 99 end,
    cond 1 eq 1 : 10 ; default : 0 end,
    filter a, b, c,
    substr x, y, z,
    length lst,
    arg lst,
    foo(1, 2, 3),
    hd lst,
    tl lst,
    isatom x,
    isnull x,
    islist x,
    isword w,
    not b,
    mkstring lst,
    isstring s,
    mkword lst,
    first strm,
    next strm,
    iseod strm,
    iserror strm,
    a and b,
    a or b,
    w1 ˆ w2,
    l1 <> l2,
    l1 :: l2,
    strm fby strm2,
    strm whenever strm2,
    strm wvr strm2,
    strm upon strm2,
    strm asa strm2,
    strm attime strm2,
    error,
    eod,
    myvar
%]
