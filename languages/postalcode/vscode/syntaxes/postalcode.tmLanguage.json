{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Postalcode",
  "scopeName": "source.postalcode",
  "patterns": [
    {
      "include": "#postalcode"
    }
  ],
  "repository": {
    "postalcode": {
      "name": "constant.other.postalcode",
      "match": "[A-Z][0-9][A-Z]\\s*[0-9][A-Z][0-9]"
    }
  }
}
