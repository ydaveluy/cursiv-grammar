{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Spass",
  "scopeName": "source.spass",
  "patterns": [
    {
      "include": "#freetext"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "freetext": {
      "name": "string.quoted.other.spass",
      "begin": "\\{\\*",
      "end": "\\*\\}"
    },
    "keywords": {
      "name": "keyword.control.spass",
      "match": "\\b(begin_problem|end_problem|list_of_descriptions|list_of_symbols|list_of_declarations|list_of_formulae|list_of_clauses|list_of_proof|list_of_general_settings|list_of_settings|end_of_list|name|author|version|logic|status|description|date|satisfiable|unsatisfiable|unknown|functions|predicates|sorts|subsort|predicate|sort|freely|generated_by|axioms|conjectures|formula|clause|forall|exists|equal|true|false|or|and|not|implies|implied|equiv|cnf|dnf|step|hypothesis|splitlevel|KIV|LEM|OTTER|PROTEIN|SATURATE|3TAP|SETHEO|SPASS|GeR|SpL|SpR|EqF|Rew|Obv|EmS|SoR|EqR|MPm|SPm|OPm|SHy|OHy|URR|Fac|Spt|Inp|Con|RRE|SSi|ClR|UnC|Ter)\\b"
    },
    "numbers": {
      "name": "constant.numeric.spass",
      "match": "-1|\\b[0-9]+\\b"
    }
  }
}
