{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Cypher",
  "scopeName": "source.cypher",
  "fileTypes": [
    "cypher"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#parameters"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.cypher",
          "match": "//.*$"
        },
        {
          "name": "comment.block.cypher",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.cypher",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.cypher",
              "match": "\\\\(u+[0-9a-fA-F]{4}|[0-7]{1,3}|[btnfr\"'\\\\])"
            }
          ]
        },
        {
          "name": "string.quoted.single.cypher",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.cypher",
              "match": "\\\\(u+[0-9a-fA-F]{4}|[0-7]{1,3}|[btnfr\"'\\\\])"
            }
          ]
        },
        {
          "name": "variable.other.cypher",
          "begin": "`",
          "end": "`"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.cypher",
          "match": "(?i)\\b(0x[0-9a-f_]+|0o[0-7_]+|[0-9][0-9_]*(\\.[0-9][0-9_]*)?([eE][+-]?[0-9][0-9_]*)?[fd]?)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "constant.language.cypher",
          "match": "(?i)\\b(true|false|null)\\b"
        },
        {
          "name": "keyword.control.cypher",
          "match": "(?i)\\b(MATCH|OPTIONAL|WHERE|CREATE|MERGE|ON|SET|DELETE|DETACH|REMOVE|WITH|UNWIND|RETURN|UNION|ALL|AS|ORDER|BY|ASC|ASCENDING|DESC|DESCENDING|SKIP|LIMIT|CALL|YIELD|DISTINCT|CASE|WHEN|THEN|ELSE|END|EXISTS|FILTER|EXTRACT|COUNT|ANY|NONE|SINGLE)\\b"
        },
        {
          "name": "keyword.operator.word.cypher",
          "match": "(?i)\\b(AND|OR|XOR|NOT|IN|IS|STARTS|ENDS|CONTAINS)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.cypher",
          "match": "<=|>=|<>|\\+=|\\.\\.|[=<>+\\-*/%^|:]"
        }
      ]
    },
    "parameters": {
      "patterns": [
        {
          "name": "variable.parameter.cypher",
          "match": "\\$[A-Za-z_][A-Za-z0-9_]*|\\$[0-9]+"
        }
      ]
    }
  }
}
