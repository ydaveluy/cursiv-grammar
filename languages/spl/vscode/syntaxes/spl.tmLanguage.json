{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Spl",
  "scopeName": "source.spl",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#commands" },
    { "include": "#functions" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.spl",
          "match": "//.*$"
        },
        {
          "name": "comment.block.spl",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.spl",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.spl", "match": "\\\\." }
      ]
    },
    "keywords": {
      "name": "keyword.control.spl",
      "match": "(?i)\\b(AND|OR|NOT|AS|BY|IN|LIKE|OUTPUT|OUTPUTNEW)\\b"
    },
    "commands": {
      "name": "keyword.other.command.spl",
      "match": "(?i)\\b(search|from|tstats|stats|eval|where|table|fields|sort|rename|lookup|join|append|dedup|top|rare|head|tail|timechart|chart|rex|regex|convert|transaction|streamstats|eventstats|makeresults|inputlookup|outputlookup)\\b"
    },
    "functions": {
      "name": "support.function.spl",
      "match": "(?i)\\b(now|earliest|latest|abs|round|len|split|substr|upper|lower|trim|if|case|coalesce|isnull|isnotnull|match|replace|strftime|strptime|relative_time|avg|count|sum|min|max|median|mode)\\b(?=\\s*\\()"
    },
    "numbers": {
      "name": "constant.numeric.spl",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    }
  }
}
