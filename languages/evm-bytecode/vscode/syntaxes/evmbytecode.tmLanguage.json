{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "EvmBytecode",
  "scopeName": "source.evmbytecode",
  "patterns": [
    {
      "include": "#unknown"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "unknown": {
      "name": "string.quoted.single.evmbytecode",
      "match": "'[0-9a-fA-F]{2}'\\s?\\(Unknown Opcode\\)"
    },
    "keywords": {
      "name": "keyword.other.opcode.evmbytecode",
      "match": "\\b(RETURNDATASIZE|RETURNDATACOPY|CALLDATALOAD|CALLDATASIZE|CALLDATACOPY|DELEGATECALL|CALLBLACKBOX|SELFDESTRUCT|EXTCODESIZE|EXTCODECOPY|EXTCODEHASH|SELFBALANCE|SSTOREBYTES|SIGNEXTEND|DIFFICULTY|SLOADBYTES|STATICCALL|CALLVALUE|BLOCKHASH|TIMESTAMP|BEGINDATA|RETURNSUB|TXEXECGAS|CODESIZE|CODECOPY|GASPRICE|COINBASE|GASLIMIT|JUMPDEST|JUMPSUBV|BEGINSUB|PUTLOCAL|CALLCODE|ADDRESS|BALANCE|CHAINID|BASEFEE|MSTORE8|JUMPSUB|GETLOCA|CREATE2|INVALID|ADDMOD|MULMOD|ISZERO|ORIGIN|CALLER|NUMBER|MSTORE|SSTORE|SWAP10|SWAP11|SWAP12|SWAP13|SWAP14|SWAP15|SWAP16|JUMPTO|JUMPIF|CREATE|RETURN|REVERT|PUSH10|PUSH11|PUSH12|PUSH13|PUSH14|PUSH15|PUSH16|PUSH17|PUSH18|PUSH19|PUSH20|PUSH21|PUSH22|PUSH23|PUSH24|PUSH25|PUSH26|PUSH27|PUSH28|PUSH29|PUSH30|PUSH31|PUSH32|MLOAD|SLOAD|JUMPI|MSIZE|DUP10|DUP11|DUP12|DUP13|DUP14|DUP15|DUP16|SWAP1|SWAP2|SWAP3|SWAP4|SWAP5|SWAP6|SWAP7|SWAP8|SWAP9|SSIZE|PUSH1|PUSH2|PUSH3|PUSH4|PUSH5|PUSH6|PUSH7|PUSH8|PUSH9|STOP|SDIV|SMOD|BYTE|SHA3|JUMP|DUP1|DUP2|DUP3|DUP4|DUP5|DUP6|DUP7|DUP8|DUP9|LOG0|LOG1|LOG2|LOG3|LOG4|CALL|ADD|MUL|SUB|DIV|MOD|EXP|SLT|SGT|AND|XOR|NOT|SHL|SHR|SAR|POP|GAS|LT|GT|EQ|OR|PC)\\b"
    },
    "numbers": {
      "name": "constant.numeric.hex.evmbytecode",
      "match": "\\b0[xX][0-9a-fA-F]+\\b"
    }
  }
}
