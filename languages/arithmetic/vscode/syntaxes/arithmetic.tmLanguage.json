{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Arithmetic",
  "scopeName": "source.arithmetic",
  "fileTypes": ["arithmetic"],
  "patterns": [
    {
      "name": "constant.numeric.arithmetic",
      "match": "[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?"
    },
    {
      "name": "keyword.operator.arithmetic",
      "match": "[+\\-*/^=<>]"
    },
    {
      "name": "punctuation.parenthesis.arithmetic",
      "match": "[()]"
    },
    {
      "name": "variable.other.arithmetic",
      "match": "[a-zA-Z_][a-zA-Z0-9_]*"
    }
  ]
}
