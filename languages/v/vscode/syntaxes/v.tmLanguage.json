{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "V",
  "scopeName": "source.v",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.v",
          "match": "//.*$"
        },
        {
          "name": "comment.block.v",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.single.v",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.v",
          "match": "\\\\(u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8}|x[0-9a-fA-F]{2}|[0-7]{3}|.)"
        }
      ]
    },
    "keywords": {
      "name": "keyword.control.v",
      "match": "\\b(module|import|const|mut|struct|fn|pub|interface|map|if|else|switch|case|default|for|in|return|break|continue)\\b"
    },
    "numbers": {
      "name": "constant.numeric.v",
      "match": "\\b(0[xX][0-9a-fA-F]+|[0-9]+\\.[0-9]*([eE][+-]?[0-9]+)?|\\.[0-9]+([eE][+-]?[0-9]+)?|[0-9]+([eE][+-]?[0-9]+)?)\\b"
    }
  }
}
