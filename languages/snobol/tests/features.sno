* feature coverage: comments, blank lines, subscripts, indirection,
* builtins of every arity, lists, grouping, both quote kinds, transfers

OUTPUT = "start"
N = 5
M = -3
S = N + M * 2
P = N ^ M + 1
A[I,J] = "cell"
&IND = "indirect"
NAME "x"
OUTPUT = ident(N)
OUTPUT = date()
OUTPUT = dupl(N, M)
OUTPUT = replace(N, M, S)
OUTPUT = array(N, M)
OUTPUT = [N, M, S]
OUTPUT = (N + M)
OUTPUT = 'single quoted'
LOOP OUTPUT = "loop" :S(LOOP)
OUTPUT = "go" :F(LOOP)
OUTPUT = "toend" :(END)
OUTPUT = "notarget" :
END
