[
  {
    "id": "original-example",
    "file": "cases/original-example.bp",
    "source": "// comment\ncc_binary {\n    name: \"example1\",\n    srcs: [\n        \"example1.c\",\n        \"example2.c\",\n    ],\n    cflags: [\"-Wall\"],\n}\n\nfoo = \"bar\"\n\n/*\n * comments\n * comments\n */\ncc_library {\n    name: \"example2\",\n    enable: select((arch(), os()), {\n\t\t(any @ bar, default): true,\n\t}),\n\tfoobar: {\n\t    value: foo + \"bar\",\n\t},\n}\n"
  },
  {
    "id": "original-features-invalid",
    "file": "cases/original-features-invalid.bp",
    "source": "// Constructs example1.bp does not exercise: `+=`, a module in `(...)` form,\n// a negative integer, an escaped quote, a bare (unparenthesized) select\n// condition, and a select case whose value is `unset`.\nextra_flags = [\"-Wall\"]\nextra_flags += [\"-Wextra\"]\n\ncount = -5\n\nquoted = \"she said \\\"hi\\\"\"\n\ncc_defaults(\n    name: \"base_defaults\",\n    cflags: extra_flags,\n)\n\ncc_binary {\n    name: \"tool\",\n    srcs: [\"main.c\"],\n    count: count,\n    enable: select(product_variable(\"debug\"), {\n        true: true,\n        default: unset,\n    }),\n}\n"
  },
  {
    "id": "features-corrected",
    "file": "cases/features-corrected.bp",
    "source": "// Constructs example1.bp does not exercise: `+=`, a module in `(...)` form,\n// a negative integer, an escaped quote, a bare (unparenthesized) select\n// condition, and a select case whose value is `unset`.\nextra_flags = [\"-Wall\"]\nextra_flags += [\"-Wextra\"]\n\ncount = -5\n\nquoted = \"she said \\\"hi\\\"\"\n\ncc_defaults(\n    name = \"base_defaults\",\n    cflags = extra_flags,\n)\n\ncc_binary {\n    name: \"tool\",\n    srcs: [\"main.c\"],\n    count: count,\n    enable: select(product_variable(\"debug\"), {\n        true: true,\n        default: unset,\n    }),\n}\n"
  },
