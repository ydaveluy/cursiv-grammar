{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Rust",
  "scopeName": "source.rust",
  "patterns": [
    { "include": "#comments" },
    { "include": "#attributes" },
    { "include": "#keywords" },
    { "include": "#lifetimes" },
    { "include": "#strings" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.rust", "match": "//.*$" },
        {
          "name": "comment.block.rust",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [{ "include": "#comments" }]
        }
      ]
    },
    "attributes": {
      "name": "meta.attribute.rust",
      "begin": "#!?\\[",
      "end": "\\]",
      "patterns": [{ "include": "#strings" }, { "include": "#numbers" }]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.rust",
          "match": "\\b(as|break|continue|else|for|if|in|loop|match|return|while|yield)\\b"
        },
        {
          "name": "storage.modifier.rust",
          "match": "\\b(async|await|const|crate|dyn|extern|fn|impl|let|mod|move|mut|pub|ref|static|struct|enum|trait|type|union|unsafe|use|where)\\b"
        },
        {
          "name": "constant.language.rust",
          "match": "\\b(true|false|self|Self|super)\\b"
        }
      ]
    },
    "lifetimes": {
      "name": "storage.modifier.lifetime.rust",
      "match": "'[a-zA-Z_][a-zA-Z0-9_]*\\b(?!')"
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.rust",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "name": "constant.character.escape.rust", "match": "\\\\." }]
        },
        { "name": "string.quoted.double.raw.rust", "match": "r#*\"[^\"]*\"#*" },
        {
          "name": "string.quoted.single.rust",
          "match": "'([^'\\\\]|\\\\.)'"
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.rust",
      "match": "\\b(0x[0-9a-fA-F_]+|0o[0-7_]+|0b[01_]+|[0-9][0-9_]*(\\.[0-9_]+)?([eE][+-]?[0-9_]+)?)(u8|u16|u32|u64|u128|usize|i8|i16|i32|i64|i128|isize|f32|f64)?\\b"
    }
  }
}
