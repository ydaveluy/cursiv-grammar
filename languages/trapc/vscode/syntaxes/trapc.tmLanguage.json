{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "trapc",
  "scopeName": "source.trapc",
  "fileTypes": ["tc"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#preprocessor" },
    { "include": "#keywords" },
    { "include": "#strings" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.block.trapc", "begin": "/\\*", "end": "\\*/" },
        { "name": "comment.line.double-slash.trapc", "match": "//.*$" }
      ]
    },
    "preprocessor": {
      "name": "meta.preprocessor.trapc",
      "begin": "^\\s*#",
      "end": "(?=$)",
      "patterns": [
        {
          "name": "keyword.control.directive.trapc",
          "match": "\\b(define|elif|else|endif|error|if|ifdef|ifndef|include|line|pragma|undef)\\b"
        },
        {
          "name": "string.quoted.other.include.trapc",
          "match": "<[^>\\r\\n]*>|\"[^\"\\r\\n]*\""
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.trap.trapc",
          "match": "\\btrap\\b"
        },
        {
          "name": "keyword.control.trapc",
          "match": "\\b(break|case|continue|default|do|else|for|if|return|switch|while)\\b"
        },
        {
          "name": "keyword.control.trapc",
          "match": "\\b__label__\\b"
        },
        {
          "name": "keyword.operator.word.trapc",
          "match": "\\b(sizeof|alignof|_Alignof|__alignof__|__alignof|_Countof|_Maxof|_Minof|typeof|__typeof__|__typeof|typeof_unqual|__typeof_unqual__|_Generic|_Static_assert|static_assert|__real__|__imag__|__builtin_va_arg|__builtin_offsetof|__builtin_choose_expr|__builtin_types_compatible_p|__builtin_tgmath|__builtin_complex)\\b"
        },
        {
          "name": "storage.type.trapc",
          "match": "\\b(_Bool|bool|char|double|enum|float|int|long|short|signed|struct|union|unsigned|void|_Complex|__m128|__m128d|__m128i|_BitInt|_Decimal32|_Decimal64|_Decimal128|_Imaginary)\\b"
        },
        {
          "name": "storage.modifier.trapc",
          "match": "\\b(auto|const|constexpr|extern|inline|__inline__|__inline|register|restrict|__restrict__|__restrict|static|thread_local|typedef|volatile|__volatile__|_Atomic|_Noreturn|_Thread_local|alignas|_Alignas|__declspec|__cdecl|__clrcall|__stdcall|__fastcall|__thiscall|__vectorcall)\\b"
        },
        {
          "name": "constant.language.trapc",
          "match": "\\b(true|false|nullptr)\\b"
        },
        {
          "name": "variable.language.trapc",
          "match": "\\b(__func__|__FUNCTION__|__PRETTY_FUNCTION__)\\b"
        },
        {
          "name": "keyword.other.asm.trapc",
          "match": "\\b(asm|__asm|__asm__|__extension__|__attribute__|__attribute)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.trapc",
          "begin": "(u8|[LuU])?\"",
          "end": "\"",
          "patterns": [{ "include": "#escapes" }]
        },
        {
          "name": "string.quoted.single.trapc",
          "begin": "[LuU]?'",
          "end": "'",
          "patterns": [{ "include": "#escapes" }]
        }
      ]
    },
    "escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.trapc",
          "match": "\\\\(x[0-9a-fA-F]+|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8}|[0-7]{1,3}|.)"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.trapc",
          "match": "\\b(0[xX][0-9a-fA-F]+|0[bB][01]+|\\d+(\\.\\d*)?([eE][+-]?\\d+)?)([uUlL]+|[fFlL])?|\\.\\d+([eE][+-]?\\d+)?[fFlL]?"
        }
      ]
    }
  }
}
