{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Useragent",
  "scopeName": "source.useragent",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "name": "comment.block.useragent",
      "begin": "\\(",
      "end": "\\)"
    },
    "punctuation": {
      "name": "punctuation.separator.useragent",
      "match": "[/.]"
    }
  }
}
