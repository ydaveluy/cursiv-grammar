{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Velocity",
  "scopeName": "source.velocity",
  "patterns": [
    { "include": "#comments" },
    { "include": "#directives" },
    { "include": "#references" },
    { "include": "#strings" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.velocity",
          "match": "##.*$"
        },
        {
          "name": "comment.block.velocity",
          "begin": "#\\*",
          "end": "\\*#"
        }
      ]
    },
    "directives": {
      "name": "keyword.control.velocity",
      "match": "#\\{?\\b(if|elseif|else|foreach|set|end|break|stop|macro|include|parse|evaluate|define)\\b\\}?"
    },
    "references": {
      "patterns": [
        {
          "name": "variable.other.velocity",
          "match": "\\$!?\\{?[a-zA-Z][a-zA-Z0-9_-]*\\}?"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.velocity",
          "begin": "\"",
          "end": "\""
        },
        {
          "name": "string.quoted.single.velocity",
          "begin": "'",
          "end": "'"
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.velocity",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    }
  }
}
