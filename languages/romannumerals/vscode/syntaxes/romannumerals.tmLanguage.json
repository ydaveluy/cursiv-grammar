{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Romannumerals",
  "scopeName": "source.romannumerals",
  "fileTypes": [
    "romannumerals"
  ],
  "patterns": [
    {
      "name": "constant.numeric.romannumerals",
      "match": "\\bM*(CM|CD|D?C{0,3})(XC|XL|L?X{0,3})(IX|IV|V?I{0,3})\\b"
    },
    {
      "name": "invalid.illegal.romannumerals",
      "match": "[A-Za-z]+"
    }
  ]
}
