GEO:37.386013;-122.082932
PRIORITY:5
STATUS:CONFIRMED
CLASS:PUBLIC
ORGANIZER;CN="Alice Example":mailto:alice@example.com
ATTENDEE;ROLE=REQ-PARTICIPANT;PARTSTAT=ACCEPTED;CN=Bob:mailto:bob@example.com
