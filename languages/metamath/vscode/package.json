{
  "name": "metamath",
  "displayName": "Metamath",
  "description": "The metamath language, parsed by cursiv",
  "version": "0.1.0",
  "publisher": "example",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:metamath"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "metamath",
        "aliases": [
          "Metamath"
        ],
        "extensions": [
          ".mm"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "metamath",
        "scopeName": "source.metamath",
        "path": "./syntaxes/metamath.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Metamath",
      "properties": {
        "metamath.server.path": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the metamath_lsp executable. Empty means the packaged copy, then ../build/."
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "cursiv.metamath.mcp",
        "label": "cursiv Metamath"
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "bundle": "node esbuild.mjs --production",
    "typecheck": "tsc -p tsconfig.json",
    "vscode:prepublish": "npm run bundle",
    "package": "vsce package --no-dependencies --allow-missing-repository"
  },
  "files": [
    "package.json",
    "out",
    "{bin,server}/**",
    "language-configuration.json",
    "syntaxes"
  ],
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "~1.86.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "@vscode/vsce": "^3.9.2"
  },
  "overrides": {
    "@vscode/vsce": {
      "@azure/identity": "4.13.0"
    },
    "@azure/msal-node": {
      "uuid": "^11.1.1"
    }
  }
}
