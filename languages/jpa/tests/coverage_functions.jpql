SELECT e
FROM Employee e, IN (e.projects) p
WHERE LENGTH(e.name) > 3
  AND LOCATE(e.name, 'Smith', 1) > 0
  AND ABS(e.salary) = e.salary
  AND SQRT(e.salary) > 0
  AND MOD(e.salary, 1000) = 0
  AND SIZE(e.projects) > 0
  AND CONCAT(e.firstName, e.lastName) = e.fullName
  AND SUBSTRING(e.name, 1, 3) = 'Sam'
  AND TRIM(LEADING '!' FROM e.name) = e.name
  AND LOWER(e.name) = UPPER(e.name)
  AND e.hireDate = CURRENT_DATE
  AND e.startTime = CURRENT_TIME
  AND e.stamp = CURRENT_TIMESTAMP
  AND e.id = ?1
  AND e.dept = :dept
  AND -e.rating + 1 = 0
  AND NOT e.active = true
  AND e.rank = SOME (SELECT r.rank FROM Rank r)
