{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Python",
  "scopeName": "source.python",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.number-sign.python",
      "match": "#.*$"
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.python",
          "begin": "(?i:r|u|b|br|rb|f|fr|rf|t|tr|rt)?'''",
          "end": "'''"
        },
        {
          "name": "string.quoted.triple.python",
          "begin": "(?i:r|u|b|br|rb|f|fr|rf|t|tr|rt)?\"\"\"",
          "end": "\"\"\""
        },
        {
          "name": "string.quoted.single.python",
          "begin": "(?i:r|u|b|br|rb|f|fr|rf|t|tr|rt)?'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.python",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.python",
          "begin": "(?i:r|u|b|br|rb|f|fr|rf|t|tr|rt)?\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.python",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "name": "keyword.control.python",
      "match": "\\b(False|None|True|and|as|assert|async|await|break|class|continue|def|del|elif|else|except|finally|for|from|global|if|import|in|is|lambda|nonlocal|not|or|pass|raise|return|try|while|with|yield)\\b"
    },
    "numbers": {
      "name": "constant.numeric.python",
      "match": "\\b0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|[0-9][0-9_]*\\.?[0-9_]*([eE][+-]?[0-9_]+)?[jJ]?\\b"
    }
  }
}
