{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Databank",
  "scopeName": "source.databank",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#na"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.databank",
      "match": "\"c[^\"]*\""
    },
    "na": {
      "name": "constant.language.na.databank",
      "match": "\\bNA\\b"
    },
    "numbers": {
      "name": "constant.numeric.databank",
      "match": "[+-]?[0-9]+(\\.[0-9]*)?([eE][+-]?[0-9]+)?"
    }
  }
}
