{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "propcalc",
  "scopeName": "source.propcalc",
  "fileTypes": [
    "propcalc"
  ],
  "patterns": [
    {
      "include": "#operators"
    },
    {
      "include": "#variables"
    }
  ],
  "repository": {
    "operators": {
      "name": "keyword.operator.propcalc",
      "match": "<->|->|\\|-|\\^|!|v"
    },
    "variables": {
      "name": "variable.other.propcalc",
      "match": "[A-UW-Za-uw-z]+"
    }
  }
}
