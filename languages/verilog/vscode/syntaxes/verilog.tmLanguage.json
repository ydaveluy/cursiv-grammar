{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Verilog",
  "scopeName": "source.verilog",
  "patterns": [
    { "include": "#comments" },
    { "include": "#directives" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.verilog",
          "match": "//.*$"
        },
        {
          "name": "comment.block.verilog",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "directives": {
      "name": "meta.preprocessor.verilog",
      "match": "`[A-Za-z_][A-Za-z0-9_$]*"
    },
    "strings": {
      "name": "string.quoted.double.verilog",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.verilog", "match": "\\\\." }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.verilog",
          "match": "\\b[0-9][0-9_]*\\s*'[sS]?[bB][01xXzZ?_]+"
        },
        {
          "name": "constant.numeric.verilog",
          "match": "\\b[0-9][0-9_]*\\s*'[sS]?[oO][0-7xXzZ?_]+"
        },
        {
          "name": "constant.numeric.verilog",
          "match": "\\b[0-9][0-9_]*\\s*'[sS]?[dD][0-9xXzZ?_]+"
        },
        {
          "name": "constant.numeric.verilog",
          "match": "\\b[0-9][0-9_]*\\s*'[sS]?[hH][0-9a-fA-FxXzZ?_]+"
        },
        {
          "name": "constant.numeric.verilog",
          "match": "\\b[0-9][0-9_]*\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.verilog",
          "match": "\\b[0-9][0-9_]*[eE][+-]?[0-9]+\\b"
        },
        {
          "name": "constant.numeric.verilog",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.verilog",
          "match": "\\b(if|else|case|casex|casez|endcase|default|for|while|repeat|forever|wait|disable|fork|join|begin|end|generate|endgenerate)\\b"
        },
        {
          "name": "storage.type.verilog",
          "match": "\\b(module|macromodule|endmodule|primitive|endprimitive|function|endfunction|task|endtask|specify|endspecify|table|endtable|config|endconfig|generate|endgenerate)\\b"
        },
        {
          "name": "storage.modifier.verilog",
          "match": "\\b(input|output|inout|reg|wire|tri|tri0|tri1|triand|trior|trireg|wand|wor|uwire|supply0|supply1|integer|real|realtime|time|parameter|localparam|specparam|genvar|event|signed|automatic|vectored|scalared|defparam)\\b"
        },
        {
          "name": "keyword.other.verilog",
          "match": "\\b(assign|deassign|force|release|always|initial|posedge|negedge|edge|and|nand|or|nor|xor|xnor|buf|not|bufif0|bufif1|notif0|notif1|nmos|pmos|rnmos|rpmos|cmos|rcmos|tran|rtran|tranif0|tranif1|rtranif0|rtranif1|pullup|pulldown|highz0|highz1|small|medium|large|strong0|strong1|weak0|weak1|supply0|supply1)\\b"
        }
      ]
    }
  }
}
