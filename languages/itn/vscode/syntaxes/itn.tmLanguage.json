{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Itn",
  "scopeName": "source.itn",
  "fileTypes": ["itn"],
  "patterns": [
    {
      "name": "constant.numeric.itn",
      "match": "[0-9]+"
    },
    {
      "name": "punctuation.separator.pipe.itn",
      "match": "\\|"
    }
  ]
}
