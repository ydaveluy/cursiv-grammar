{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Stl",
  "scopeName": "source.stl",
  "patterns": [
    {
      "include": "#keywords"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "keywords": {
      "name": "keyword.control.stl",
      "match": "\\b(solid|endsolid|facet|endfacet|normal|outer|loop|vertex|endloop)\\b"
    },
    "numbers": {
      "name": "constant.numeric.stl",
      "match": "\\b([0-9]*\\.[0-9]+|[0-9]+\\.)([eE][+-]?[0-9]+)?\\b|\\b[0-9]+[eE][+-]?[0-9]+\\b"
    }
  }
}
