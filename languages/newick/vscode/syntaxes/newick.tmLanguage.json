{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Newick",
  "scopeName": "source.newick",
  "patterns": [
    {
      "include": "#numbers"
    },
    {
      "include": "#labels"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "numbers": {
      "name": "constant.numeric.newick",
      "match": "[0-9]+(\\.[0-9]+)?"
    },
    "labels": {
      "name": "entity.name.tag.newick",
      "match": "[a-zA-Z][a-zA-Z0-9]*"
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.group.newick",
          "match": "[()]"
        },
        {
          "name": "punctuation.separator.newick",
          "match": ","
        },
        {
          "name": "punctuation.definition.length.newick",
          "match": ":"
        },
        {
          "name": "punctuation.terminator.statement.newick",
          "match": ";"
        }
      ]
    }
  }
}
