{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Qif",
  "scopeName": "source.qif",
  "patterns": [
    { "include": "#recordtype" },
    { "include": "#terminator" },
    { "include": "#fieldcode" },
    { "include": "#brackets" },
    { "include": "#numbers" }
  ],
  "repository": {
    "recordtype": {
      "name": "keyword.control.qif",
      "match": "^!Type:"
    },
    "terminator": {
      "name": "keyword.operator.qif",
      "match": "^\\^$"
    },
    "fieldcode": {
      "name": "keyword.other.qif",
      "match": "^[DTNCMPL]"
    },
    "brackets": {
      "name": "punctuation.definition.qif",
      "match": "[\\[\\]]"
    },
    "numbers": {
      "name": "constant.numeric.qif",
      "match": "-?[0-9,]+(\\.[0-9]+)?"
    }
  }
}
