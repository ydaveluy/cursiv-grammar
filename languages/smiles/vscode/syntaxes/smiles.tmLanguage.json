{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Smiles",
  "scopeName": "source.smiles",
  "patterns": [
    {
      "include": "#bracket-atom"
    },
    {
      "include": "#organic-atom"
    },
    {
      "include": "#bond"
    },
    {
      "include": "#ring-bond"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "bracket-atom": {
      "name": "meta.bracket-atom.smiles",
      "begin": "\\[",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.bracket-atom.begin.smiles" }
      },
      "end": "\\]",
      "endCaptures": {
        "0": { "name": "punctuation.definition.bracket-atom.end.smiles" }
      },
      "patterns": [
        {
          "name": "constant.numeric.isotope.smiles",
          "match": "^[0-9]+"
        },
        {
          "name": "entity.name.type.element.smiles",
          "match": "He|Li|Be|Ne|Na|Mg|Al|Si|Cl|Ar|Ca|Sc|Ti|Cr|Mn|Fe|Co|Ni|Cu|Zn|Ga|Ge|As|Se|Br|Kr|Rb|Sr|Zr|Nb|Mo|Tc|Ru|Rh|Pd|Ag|Cd|In|Sn|Sb|Te|Xe|Cs|Ba|Hf|Ta|Re|Os|Ir|Pt|Au|Hg|Tl|Pb|Bi|Po|At|Rn|Fr|Ra|Rf|Db|Sg|Bh|Hs|Mt|Ds|Rg|Cn|Fl|Lv|La|Ce|Pr|Nd|Pm|Sm|Eu|Gd|Tb|Dy|Ho|Er|Tm|Yb|Lu|Ac|Th|Pa|Np|Pu|Am|Cm|Bk|Cf|Es|Fm|Md|No|Lr|se|as|[A-Z][a-z]?|[cnops]"
        },
        {
          "name": "keyword.other.chirality.smiles",
          "match": "@@?(TH[12]|AL[12]|SP[1-3]|TB[0-9]{1,2}|OH[0-9]{1,2})?"
        },
        {
          "name": "constant.numeric.hcount.smiles",
          "match": "H[0-9]?"
        },
        {
          "name": "keyword.operator.charge.smiles",
          "match": "\\+\\+|--|[+-][0-9]{0,2}"
        },
        {
          "name": "constant.numeric.class.smiles",
          "match": ":[0-9]+"
        }
      ]
    },
    "organic-atom": {
      "name": "entity.name.type.element.smiles",
      "match": "Cl|Br|[BCNOSPFI]|[bcnops]|\\*"
    },
    "bond": {
      "name": "keyword.operator.bond.smiles",
      "match": "[=#$:/\\\\.-]"
    },
    "ring-bond": {
      "name": "constant.numeric.ring-bond.smiles",
      "match": "%[0-9]{2}|[0-9]"
    },
    "punctuation": {
      "name": "punctuation.parenthesis.smiles",
      "match": "[()]"
    }
  }
}
