{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Odin",
  "scopeName": "source.odin",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#directives"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.odin",
          "match": "//.*$"
        },
        {
          "name": "comment.block.odin",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.odin",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.odin",
              "match": "\\\\(['\"\\\\abefnrtv]|[0-7]{1,3}|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8})"
            }
          ]
        },
        {
          "name": "string.quoted.other.odin",
          "begin": "`",
          "end": "`"
        },
        {
          "name": "string.quoted.single.odin",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.odin",
              "match": "\\\\(['\"\\\\abefnrtv]|[0-7]{1,3}|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8})"
            }
          ]
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.odin",
      "match": "\\b(0[xX][0-9a-fA-F_]+|0[oO][0-7_]+|0[bB][01_]+|[0-9][0-9_]*\\.?[0-9_]*([eE][+-]?[0-9]+)?[ijk]?)\\b"
    },
    "keywords": {
      "name": "keyword.control.odin",
      "match": "\\b(if|else|for|in|not_in|switch|case|when|where|return|defer|break|continue|fallthrough|package|import|proc|struct|enum|union|bit_set|bit_field|matrix|map|dynamic|distinct|using|cast|transmute|auto_cast|or_else|or_return|or_continue|or_break|foreign)\\b"
    },
    "types": {
      "name": "storage.type.odin",
      "match": "\\b(bool|b8|b16|b32|b64|int|i8|i16|i32|i64|i128|uint|u8|u16|u32|u64|u128|uintptr|f16|f32|f64|complex32|complex64|complex128|quaternion64|quaternion128|quaternion256|rune|string|cstring|rawptr|typeid|any|nil|true|false)\\b"
    },
    "directives": {
      "name": "keyword.other.directive.odin",
      "match": "#[a-zA-Z_]+"
    }
  }
}
