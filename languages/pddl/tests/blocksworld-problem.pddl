(define (problem blocksworld-1)
  (:domain blocksworld)
  (:requirements :strips :typing :equality)
  (:objects a b c - block)
  (:init (on a ground) (on b a) (clear b) (clear c)
         (not (holding a))
         (= (weight a) 3)
         (= (weight b) 5)
         (= (total-weight) 8))
  (:goal (and (on b ground) (not (on a b)) (clear a)))
  (:metric minimize (+ (total-time) (/ (* (weight a) 2) 4))))
