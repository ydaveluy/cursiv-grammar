(define (problem rover-transport-1)
  (:domain rover-transport)
  (:requirements :typing :durative-actions :preferences :constraints)
  (:objects base site1 site2 - location rover1 - physobj)
  (:init (at rover1 base) (connected base site1) (connected site1 site2)
         (= (distance base site1) 4)
         (= (distance site1 site2) 3)
         (at 5 (far base site2)))
  (:goal (and (at rover1 site2) (connected base site1)))
  (:constraints (and (preference reach-site1 (sometime (at rover1 site1)))
                      (preference no-crowding (at-most-once (busy rover1)))
                      (always (connected base site1))
                      (within 100 (at rover1 site2))
                      (sometime-after (at rover1 site1) (at rover1 site2))
                      (sometime-before (at rover1 site2) (at rover1 base))
                      (always-within 50 (at rover1 base) (at rover1 site1))
                      (hold-during 0 10 (connected base site1))
                      (hold-after 10 (connected site1 site2))
                      (at end (connected base site1))
                      (forall (?l - location) (always (connected ?l ?l)))))
  (:metric maximize (+ (* (distance base site1) (distance site1 site2) 2)
                        (is-violated reach-site1))))
