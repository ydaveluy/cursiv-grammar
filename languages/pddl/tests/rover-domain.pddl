(define (domain rover-transport)
  (:requirements :typing :durative-actions :derived-predicates
   :timed-initial-literals :fluents :negative-preconditions)
  (:types location physobj - object)
  (:predicates (at ?x - physobj ?l - location)
               (connected ?a ?l - location)
               (busy ?x - physobj)
               (far ?a ?b - location))
  (:functions (distance ?a ?b - location) (speed ?x - physobj))
  (:constraints (and (always (far loc1 loc1)) (at end (connected loc1 loc1))))
  (:durative-action move
   :parameters (?x - physobj ?from ?to - location)
   :duration (and (>= ?duration 1) (<= ?duration (distance ?from ?to)))
   :condition (and (at start (at ?x ?from))
                    (at start (connected ?from ?to))
                    (over all (not (busy ?x)))
                    (preference fast-move (at end (at ?x ?to))))
   :effect (and (at start (busy ?x))
                (at end (not (busy ?x)))
                (at end (not (at ?x ?from)))
                (at end (at ?x ?to))
                (at end (increase (distance ?from ?to) 1))))
  (:durative-action wait
   :parameters (?x - physobj)
   :duration (at start (= ?duration 1))
   :condition (forall (?y - physobj) (over all (not (busy ?y))))
   :effect (forall (?y - physobj) (at start (busy ?y))))
  (:durative-action no-op
   :parameters ()
   :duration ()
   :condition ()
   :effect (increase (distance loc1 loc1) ?duration))
  (:derived (far ?a ?b - location) (far ?a ?b)))
