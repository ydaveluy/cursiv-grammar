(define (domain blocksworld)
  (:requirements :strips :typing :equality :negative-preconditions
   :disjunctive-preconditions :existential-preconditions
   :universal-preconditions :quantified-preconditions
   :conditional-effects :fluents :adl :derived-predicates)
  (:types block table - object)
  (:constants ground - table)
  (:predicates (on ?x - block ?y - object)
               (clear ?x - object)
               (holding ?x - block)
               (movable ?x - (either block table))
               (heavy ?x - block))
  (:functions (weight ?x - block) (total-weight))
  (:action pick-up
   :parameters (?x - block ?y - object)
   :precondition (and (clear ?x) (on ?x ?y)
                       (or (clear ?y) (not (holding ?x)))
                       (not (holding ?x))
                       (imply (movable ?x) (clear ?y))
                       (= (weight ?x) (weight ?x))
                       (< (weight ?x) 1000))
   :effect (and (holding ?x) (not (on ?x ?y)) (not (clear ?x))
                (when (not (holding ?y)) (clear ?y))
                (forall (?z - block) (when (on ?z ?x) (clear ?z)))
                (increase (total-weight) (weight ?x))))
  (:action put-down
   :parameters (?x - block ?y - object)
   :precondition (and (holding ?x)
                       (exists (?w - block) (clear ?w))
                       (forall (?z - block) (imply (on ?z ?x) (clear ?z)))
                       (<= (weight ?x) 999))
   :effect (and (not (holding ?x)) (on ?x ?y) (clear ?x)
                (decrease (total-weight) (- (weight ?x) 1))
                (assign (weight ?x) (- 5))
                (scale-up (total-weight) (+ (weight ?x) 3))
                (scale-down (total-weight) 2)))
  (:derived (heavy ?x - block) (and (> (weight ?x) 10) (>= (weight ?x) 5))))
