.section /pm my_code;
.segment /dm my_data;
.endseg;

start: r0 = r1 + r2;
dm(i0, m0) = r0;
r1 = dm(i0, m0);
pm(i8, m8) = f0;
modify(i0, 4);
r0 = dm(0x10, i1);
r2 = mrf;
r3 = r3 * r4;
mr1f = r5;
mrb = r7 * r8;
r9 = r10 and r11;
r0 = r1 + r2, r2 = r3 - r4;
r0 = r1 * r2, r5 = r6 + r7;
f0 = f1 + f2;
r0 = lshift r1 by r2;
r0 = ashift r1 by 4;
r0 = rot r1 by r2;
btst r0 by r1;
if eq jump start;
if ne call start (db);
if eq jump (pc, start), else r0 = r1 + r2;
lcntr = 5, do (pc, start) until lce;
do (pc, start) until forever;
rts;
rts (db);
push loop;
pop loop, push sts;
cjump (pc, start);
bit set mode2 0x00000070;
r0 = (r1 + r2) / 2;
r0 = r1 - 1;
r0 = r1 + 1;
.var count;
.var x, y, z;
.var offset = 42 + 1;
