{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Iso8601",
  "scopeName": "source.iso8601",
  "patterns": [
    {
      "include": "#designators"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "designators": {
      "name": "keyword.control.iso8601",
      "match": "[TtZzWwPpRr]"
    },
    "numbers": {
      "name": "constant.numeric.iso8601",
      "match": "[0-9]+([,.][0-9]+)?"
    }
  }
}
