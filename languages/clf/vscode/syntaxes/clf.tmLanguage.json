{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Clf",
  "scopeName": "source.clf",
  "patterns": [
    {
      "include": "#datetime"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "datetime": {
      "name": "constant.other.datetime.clf",
      "match": "\\[[0-9]+/[a-zA-Z0-9();._-]+/[0-9]+:[0-9]+:[0-9]+:[0-9]+ -[0-9]+\\]"
    },
    "strings": {
      "name": "string.quoted.double.clf",
      "match": "\"[^\"]*\""
    },
    "numbers": {
      "name": "constant.numeric.clf",
      "match": "\\b[0-9]+(\\.[0-9]+){3}\\b|\\b[0-9]+\\b"
    }
  }
}
