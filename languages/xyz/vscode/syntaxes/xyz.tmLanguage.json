{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Xyz",
  "scopeName": "source.xyz",
  "fileTypes": ["xyz"],
  "patterns": [
    {
      "name": "entity.name.tag.xyz",
      "match": "^\\s*([A-Za-z]+)\\b"
    },
    {
      "name": "constant.numeric.xyz",
      "match": "[+-]?[0-9]+(\\.[0-9]+)?"
    }
  ]
}
