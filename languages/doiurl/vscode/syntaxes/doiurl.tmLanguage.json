{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Doiurl",
  "scopeName": "source.doiurl",
  "patterns": [
    { "include": "#scheme" },
    { "include": "#escape" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "scheme": {
      "name": "keyword.control.doiurl",
      "match": "^doi(?=:)"
    },
    "escape": {
      "name": "constant.character.escape.doiurl",
      "match": "%[0-9A-F]{2}"
    },
    "punctuation": {
      "name": "punctuation.separator.doiurl",
      "match": "[:/?#]"
    }
  }
}
