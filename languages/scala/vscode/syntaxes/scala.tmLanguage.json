{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Scala",
  "scopeName": "source.scala",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.scala",
          "match": "//.*$"
        },
        {
          "name": "comment.block.scala",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.scala",
          "begin": "\"\"\"",
          "end": "\"\"\""
        },
        {
          "name": "string.quoted.double.scala",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.scala",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.scala",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.scala",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "name": "keyword.control.scala",
      "match": "\\b(abstract|case|catch|class|def|do|else|extends|false|final|finally|for|forSome|if|implicit|import|lazy|match|new|null|object|override|package|private|protected|return|sealed|super|this|throw|trait|true|try|type|val|var|while|with|yield)\\b"
    },
    "numbers": {
      "name": "constant.numeric.scala",
      "match": "\\b(0[xX][0-9a-fA-F]+|[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?[LlFfDd]?)\\b"
    }
  }
}
