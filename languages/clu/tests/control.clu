control_showcase = proc (n: int) returns (int) signals (bad_value)
    own total: int := 0
    if n < 0 then
        signal bad_value
    elseif n = 0 then
        return(0)
    else
        total := n
        end
    while total > 1 do
        total := total - 1
        end
    for i: int in int$from_to_by(1, 3, 1) do
        if i = 2 then
            break
            end
        end
    tagcase n
        tag small: return(1)
        tag big: return(2)
        others: return(0)
        end
    invoke_something(n)
        except
        when bad_value: return(-1)
        others: return(-2)
        end
    return(total)
    end control_showcase
