{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "XsdRegex",
  "scopeName": "source.xsdregex",
  "patterns": [
    {
      "include": "#escapes"
    },
    {
      "include": "#charclass"
    },
    {
      "include": "#quantifiers"
    },
    {
      "include": "#groups"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.category.xsdregex",
          "match": "\\\\[pP]\\{[A-Za-z0-9-]+\\}"
        },
        {
          "name": "constant.character.escape.class.xsdregex",
          "match": "\\\\[sSiIcCdDwW]"
        },
        {
          "name": "constant.character.escape.xsdregex",
          "match": "\\\\."
        }
      ]
    },
    "charclass": {
      "name": "constant.other.character-class.xsdregex",
      "begin": "\\[\\^?",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.character-class.xsdregex" }
      },
      "end": "\\]",
      "endCaptures": {
        "0": { "name": "punctuation.definition.character-class.xsdregex" }
      },
      "patterns": [
        {
          "include": "#escapes"
        }
      ]
    },
    "quantifiers": {
      "patterns": [
        {
          "name": "keyword.operator.quantifier.xsdregex",
          "match": "[?*+]"
        },
        {
          "name": "keyword.operator.quantifier.xsdregex",
          "match": "\\{[0-9]+(,[0-9]*)?\\}"
        }
      ]
    },
    "groups": {
      "patterns": [
        {
          "name": "punctuation.definition.group.xsdregex",
          "match": "[()]"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.alternation.xsdregex",
          "match": "\\|"
        },
        {
          "name": "constant.character.wildcard.xsdregex",
          "match": "\\."
        }
      ]
    }
  }
}
