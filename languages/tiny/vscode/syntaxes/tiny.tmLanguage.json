{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Tiny",
  "scopeName": "source.tiny",
  "patterns": [
    {
      "include": "#keywords"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "keywords": {
      "name": "keyword.control.tiny",
      "match": "\\b(BEGIN|END|READ|WRITE)\\b"
    },
    "numbers": {
      "name": "constant.numeric.tiny",
      "match": "-?\\b[0-9]+\\b"
    },
    "operators": {
      "name": "keyword.operator.tiny",
      "match": ":=|\\+|-|,"
    }
  }
}
