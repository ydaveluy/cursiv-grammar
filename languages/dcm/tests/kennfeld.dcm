KONSERVIERUNG_FORMAT 2.0

KENNFELD KF_NUM 2 2
EINHEIT_X "rpm"
EINHEIT_Y "load"
EINHEIT_W "torque"
ST/X 1000 2000
ST/Y 0.0
WERT 1.0 2.0
ST/Y 1.0
WERT 3.0 4.0
END

FESTKENNFELD KF_FEST 2 1
ST/X 1000 2000
ST_TX/Y "full"
WERT 5.0 6.0
END

GRUPPENKENNFELD KF_GRUPPE 2 2
ST/X 0 1
ST_TX/Y "row1"
WERT 1.0 1.0
ST_TX/Y "row2"
WERT 2.0 2.0
END
