{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Pike",
  "scopeName": "source.pike",
  "patterns": [
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.pike",
          "match": "\\b(if|else|while|do|for|switch|case|default|foreach|break|continue|return)\\b"
        },
        {
          "name": "keyword.other.pike",
          "match": "\\b(import|inherit|constant|class|catch|gauge|sscanf|lambda)\\b"
        },
        {
          "name": "storage.modifier.pike",
          "match": "\\b(static|private|nomask|public|protected|inline)\\b"
        }
      ]
    },
    "types": {
      "name": "storage.type.pike",
      "match": "\\b(int|float|string|program|object|mapping|array|multiset|function)\\b"
    },
    "strings": {
      "name": "string.quoted.double.pike",
      "begin": "\"",
      "end": "\""
    },
    "numbers": {
      "name": "constant.numeric.pike",
      "match": "\\b0x[0-9]+\\b|\\b[0-9]+(\\.[0-9]+)?\\b"
    }
  }
}
