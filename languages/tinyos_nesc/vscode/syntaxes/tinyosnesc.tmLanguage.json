{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "TinyosNesc",
  "scopeName": "source.tinyosnesc",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.tinyosnesc",
          "match": "//.*$"
        },
        {
          "name": "comment.block.tinyosnesc",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.tinyosnesc",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "match": "\"\"", "name": "constant.character.escape.tinyosnesc" }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.tinyosnesc",
          "match": "\\b(if|else|while|for|switch|case|default|break|continue|return|atomic)\\b"
        },
        {
          "name": "storage.modifier.tinyosnesc",
          "match": "\\b(module|configuration|interface|implementation|generic|typedef|static|async)\\b"
        },
        {
          "name": "keyword.other.tinyosnesc",
          "match": "\\b(uses|provides|components|includes|interface|as|new|call|signal|post|event|task|command|enum)\\b"
        },
        {
          "name": "constant.language.tinyosnesc",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "support.type.tinyosnesc",
          "match": "\\b(void|char|short|long|double|boolean)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.tinyosnesc",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.tinyosnesc",
          "match": "\\b[0-9]+(\\.[0-9]*)?\\b|\\.[0-9]+\\b"
        }
      ]
    }
  }
}
