10 LET A = 5
20 LET B = -3
30 LET C = A * B / 2
40 LET D = A - B
50 IF C <= 0 THEN GOSUB C
60 IF D >= 0 PRINT "D NOT NEGATIVE"
70 IF A <> B PRINT "DIFFERENT"
80 IF A >< B PRINT "STILL DIFFERENT"
90 INPUT X, Y
CLEAR
100 IF A < B THEN IF B < C GOTO 900
110 LIST
120 LET "Q" = 1
130 RUN
140 GOTO 900
500 PRINT "IN SUBROUTINE"
510 RETURN
900 END
