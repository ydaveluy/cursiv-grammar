{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Url",
  "scopeName": "source.url",
  "patterns": [
    {
      "include": "#scheme"
    },
    {
      "include": "#percent-encoding"
    },
    {
      "include": "#ipv6"
    },
    {
      "include": "#delimiters"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "scheme": {
      "name": "entity.name.tag.scheme.url",
      "match": "^[a-zA-Z~0-9][a-zA-Z0-9.+-]*(?=://)"
    },
    "percent-encoding": {
      "name": "constant.character.escape.url",
      "match": "%[a-fA-F0-9]{2}"
    },
    "ipv6": {
      "name": "string.other.host.ipv6.url",
      "match": "\\[[0-9a-fA-F:]+\\]"
    },
    "delimiters": {
      "name": "punctuation.separator.url",
      "match": "://|[/:@?#&=]"
    },
    "numbers": {
      "name": "constant.numeric.url",
      "match": "[0-9]+"
    }
  }
}
