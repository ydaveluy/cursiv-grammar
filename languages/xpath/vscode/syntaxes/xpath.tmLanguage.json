{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Xpath",
  "scopeName": "source.xpath",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#axes"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "name": "comment.block.xpath",
      "begin": "\\(:",
      "end": ":\\)",
      "patterns": [
        {
          "include": "#comments"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.xpath",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "match": "\"\""
            }
          ]
        },
        {
          "name": "string.quoted.single.xpath",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "match": "''"
            }
          ]
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.xpath",
      "match": "\\b[0-9]+(\\.[0-9]*)?([eE][+-]?[0-9]+)?\\b|\\.[0-9]+([eE][+-]?[0-9]+)?"
    },
    "keywords": {
      "name": "keyword.control.xpath",
      "match": "\\b(for|let|some|every|if|then|else|return|in|satisfies|to|instance|of|treat|as|castable|cast|div|idiv|mod|union|intersect|except|eq|ne|lt|le|gt|ge|is|and|or|map|array|function|item|node|text|comment|document-node|element|attribute|namespace-node|schema-element|schema-attribute|processing-instruction|empty-sequence)\\b"
    },
    "axes": {
      "name": "keyword.other.axis.xpath",
      "match": "\\b(child|descendant|attribute|self|descendant-or-self|following-sibling|following|namespace|parent|ancestor|preceding-sibling|preceding|ancestor-or-self)(?=\\s*::)"
    },
    "variables": {
      "name": "variable.other.xpath",
      "match": "\\$[a-zA-Z_][\\w.-]*(:[a-zA-Z_][\\w.-]*)?"
    },
    "operators": {
      "name": "keyword.operator.xpath",
      "match": "=>|:=|!=|<=|>=|<<|>>|\\|\\||\\.\\.|::|[+\\-*/|=<>!?@]"
    }
  }
}
