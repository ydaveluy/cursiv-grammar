{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Rcs",
  "scopeName": "source.rcs",
  "patterns": [
    {
      "include": "#keywords"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#revisions"
    }
  ],
  "repository": {
    "keywords": {
      "name": "keyword.control.rcs",
      "match": "\\b(head|branch|access|symbols|locks|strict|comment|expand|date|author|state|branches|next|desc|log|text)\\b"
    },
    "strings": {
      "name": "string.quoted.other.rcs",
      "begin": "@",
      "end": "@(?!@)",
      "patterns": [
        {
          "name": "constant.character.escape.rcs",
          "match": "@@"
        }
      ]
    },
    "revisions": {
      "name": "constant.numeric.rcs",
      "match": "\\b[0-9]+(\\.[0-9]+)*\\b"
    }
  }
}
